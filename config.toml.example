# acp-bridge configuration
# All values can be overridden by environment variables.
# When spawned by openab, env vars are sufficient — this file is optional.

[llm]
# OpenAI-compatible endpoint
base_url = "http://localhost:11434/v1"

# Model name
model = "gemma4:26b"

# API key (most local services ignore this)
# api_key = "local-ai"

# Custom system prompt (auto-generated if not set)
# system_prompt = "You are a helpful coding assistant."

# Sampling temperature (0.0 - 2.0)
# temperature = 0.7

# Maximum tokens to generate
# max_tokens = 4096

# HTTP timeout in seconds
timeout_secs = 300

# Max conversation turns to keep (0 = unlimited)
# Prevents memory growth in long sessions
max_history_turns = 50

# Max tool-call rounds per prompt (0 = unlimited)
# Backstop against models that never stop requesting tools; when the
# budget is exhausted the turn ends with ACP stopReason "max_turn_requests".
# Strong agentic models may need more than the older default of 5.
max_tool_rounds = 25

# Arbitrary passthrough fields merged into the TOP LEVEL of every request
# body sent to the backend (issue #2) — for knobs acp-bridge does not
# model natively: reasoning_effort, top_p, verbosity, vendor flags…
# Applied LAST, so these win over temperature / max_tokens above.
# Reserved engine-owned keys (model, messages, stream, tools) are
# ignored with a warning. Ollama-native: top-level merge only —
# override `options` as a whole object if needed (no deep merge).
#
# [llm.request_overrides]
# reasoning_effort = "max"
# top_p = 0.95

# Context compaction (issue #25): when a round's prompt tokens cross
# this fraction of the model window (LLM_MODEL_CONTEXT), older rounds
# are summarized into a rolling note before the next request. Default
# 0.75; 0 disables. The summarizer uses the configured model unless
# compaction_model names a cheaper one.
#
# compaction_threshold = 0.75
# compaction_model = "glm-5.3-flash"

# Reasoning-effort levels advertised to Clients as a `thought_level`
# config option (issue #13, bb's reasoning-effort picker). Defaults
# to ["low", "medium", "high", "max"] on OpenAI-compatible backends
# (nothing on Ollama-native) when unset — set explicitly to override,
# or to [] to force the picker off. (`session/new` always advertises
# the `model` option listing the backend's models — issue #40, no
# config needed.) Only bb's known level names render in its picker:
# none, minimal, low, medium, high, xhigh, ultracode, max, ultra.
# Selecting a level sends session/set_config_option; every subsequent
# round's body carries reasoning_effort: <level> for that session
# (beats the request_overrides default above). In-memory per session.
#
# thought_levels = ["low", "high", "max"]

# ---------------------------------------------------------------------------
# Client mode — spawn an external ACP agent (used with --client flag)
# ---------------------------------------------------------------------------
# [agent]
# command = "opencode"
# args = ["acp"]
# working_dir = "/home/node"
#
# # Optional environment variables passed to the agent process
# [agent.env]
# OPENAI_API_KEY = "${OPENAI_API_KEY}"
